               "settings": { "ShowSeconds": false, "TimeFormat": "HH':'mm", "DateFormat": "d 'de' MMMM", "WeekdayFormat": "dddd", "TopLine": "%weekday% %time%", "BottomLine": "%date%", "TooltipLine": "-" } } },
  { "id": "ampm", "name": "12 horas (AM/PM)", "description": "Formato de 12 horas con AM/PM y fecha corta.",
