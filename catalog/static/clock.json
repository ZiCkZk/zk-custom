               "settings": { "ShowSeconds": false, "TimeFormat": "HH':'mm", "DateFormat": "d MMM", "WeekdayFormat": "ddd", "TopLine": "%time%", "BottomLine": "%weekday%, %date%", "TooltipLine": "-" } } },
  { "id": "long-date", "name": "Fecha larga", "description": "Día de la semana y hora arriba, fecha completa abajo.",
