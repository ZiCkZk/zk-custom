    "apply": { "type": "windhawk-remove", "mod": "taskbar-clock-customization", "modName": "Taskbar Clock Customization" } },
  { "id": "seconds", "name": "Hora con segundos", "description": "Hora en 24 h con segundos y la fecha debajo.",
