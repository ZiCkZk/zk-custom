    {
        "id":  "none",
        "name":  "Sin cambios",
        "description":  "No se instala ninguna fuente nueva.",
        "apply":  {
                      "type":  "font-none"
                  }
    },
    {
        "id":  "jetbrains-mono-nf",
        "name":  "JetBrains Mono",
        "description":  "Técnica y muy legible, con ligaduras. La favorita de muchos programadores. Incluye iconos Nerd Font.",
        "reference":  "https://www.programmingfonts.org/#jetbrains-mono",
        "apply":  {
                      "type":  "font",
                      "family":  "JetBrainsMono Nerd Font",
                      "source":  "github",
                      "repo":  "ryanoasis/nerd-fonts",
                      "asset":  "^JetBrainsMono\\.zip$",
                      "filter":  "^JetBrainsMonoNerdFont-.*\\.(ttf|otf)$"
                  },
        "preview":  "previews/fonts/jetbrains-mono-nf.png"
